<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>preview</LangVersion>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <AssemblyName>glacier</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>glacier</ToolCommandName>
    <PackageId>Glacier.Cli</PackageId>
    <Version>1.6.0</Version>
    <PackageReleaseNotes>v1.6.0: Pure C# NativeAOT GGUF deep audit (glacier inspect --audit) and LoRA adapter audit (glacier audit-adapter).</PackageReleaseNotes>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Authors>Ian Cowley</Authors>
    <Company>Glacier High-Performance Ecosystem</Company>
    <Description>Unified pure C# .NET 10 LLM command-line application (glacier). High-performance inference with Universal Architecture Matrix (Llama 3, Phi-4, DeepSeek, Mistral, Qwen), in-process LoRA fine-tuning (Glacier.Tune), GGUF adapter fusion, in-process SIMD GraphRAG (Glacier.Rag), PagedAttention continuous batching server (Glacier.Serve), autonomous agent runtime (Glacier.Agent), and HuggingFace GGUF model downloader.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ian-cowley/Glacier.Cli</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ian-cowley/Glacier.Cli.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>llm;inference;fine-tuning;lora;graphrag;continuous-batching;paged-attention;ollama;vllm;agent;cli;net10;glacier</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Glacier.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../Glacier.Inference/src/Glacier.Inference/Glacier.Inference.csproj" Condition="Exists('../../../Glacier.Inference/src/Glacier.Inference/Glacier.Inference.csproj') and '$(UseLocalProjectReferences)' != 'false'" />
    <PackageReference Include="Glacier.Inference" Condition="!Exists('../../../Glacier.Inference/src/Glacier.Inference/Glacier.Inference.csproj') or '$(UseLocalProjectReferences)' == 'false'" />

